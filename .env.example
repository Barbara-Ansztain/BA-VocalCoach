# === Copiá estas mismas claves en Netlify → Site configuration → Environment variables ===
# Scope: All scopes (Build + Runtime). Después de pegarlas, redeploy.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dominio final (sin / al final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend → API Keys (+ dominio verificado)
RESEND_API_KEY=
EMAIL_FROM="BA - Vocal Coach <clases@tudominio.com>"
ADMIN_EMAIL=

# Mercado Pago → Credenciales de producción (o prueba)
MP_ACCESS_TOKEN=
# Webhook secret: Tus integraciones → Webhooks → https://TU_DOMINIO/api/mercadopago/webhook
MP_WEBHOOK_SECRET=

# Zoom Marketplace → App Server-to-Server OAuth (meeting:write)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
