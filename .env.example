# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para links en mails y Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mails (Gmail con contraseña de aplicación)
SMTP_USER=
SMTP_PASS=
# Adonde llegan los avisos de consultas nuevas (y a quién responden los alumnos)
ADMIN_EMAIL=

# Mercado Pago (Tus integraciones → credenciales de producción)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Zoom (app Server-to-Server OAuth en marketplace.zoom.us)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
